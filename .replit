run = "cd autonomous-claude && python3 web_app.py"
language = "python3"
entrypoint = "autonomous-claude/web_app.py"

[nix]
channel = "stable-22_11"

[deployment]
run = ["sh", "-c", "cd autonomous-claude && python3 web_app.py"]
deploymentTarget = "cloudrun"

[env]
FLASK_APP = "autonomous-claude/web_app.py"
FLASK_ENV = "development"
